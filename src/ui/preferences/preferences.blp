using Gtk 4.0;
using Adw 1;

template $KaoriPreferencesDialog : Adw.PreferencesDialog {
  Adw.PreferencesPage {
    title: _("Reader");
    icon-name: "view-paged-symbolic";

    Adw.PreferencesGroup {
      title: _("Reading");
      description: _("This sets the global reader settings");

      Adw.InlineViewSwitcher {
        margin-top: 12;
        stack: bind template.mode_stack;
        margin-bottom: 12;
        sensitive: bind template.loaded;
      }

      Adw.ComboRow orientation_row {
        title: _("Webtoon Orientation");
        model: Gtk.StringList {
          strings [_("Vertical"), _("Horizontal")]
        };
        notify::selected => $on_orientation_changed();
      }

      Adw.ComboRow direction_row {
        title: _("Reading Direction");
        model: Gtk.StringList {
          strings [_("Left to Right"), _("Right to Left")]
        };
        sensitive: bind template.loaded;
        notify::selected => $on_direction_changed();
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Downloads");
    icon-name: "folder-download-symbolic";

    Adw.PreferencesGroup {
      title: _("Storage");

      Adw.SwitchRow cbz_row {
        title: _("Save as CBZ Archive");
        subtitle: _("Compress each downloaded chapter into a single CBZ file");
        sensitive: bind template.loaded;
        notify::active => $on_cbz_toggled();
      }

      Adw.ActionRow location_row {
        title: _("Download Location");
        subtitle: _("Choose where downloaded chapters are stored");
        activatable: true;
        sensitive: bind template.loaded;
        activated => $on_location_activated();

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
        }
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Server");
    icon-name: "network-server-symbolic";

    Adw.PreferencesGroup background_group {
      title: _("Background");

      Adw.SwitchRow background_row {
        title: _("Keep Server Running in Background");
        subtitle: _("Keep the local server running after the window is closed");
      }

      Adw.SwitchRow startup_row {
        title: _("Run on Startup");
        subtitle: _("Start the server automatically when you log in");
        sensitive: bind background_row.active;
      }
    }

    Adw.PreferencesGroup {
      title: _("Extensions");

      Adw.ActionRow {
        title: _("Extension Stores");
        subtitle: _("Where extensions can be installed from");
        activatable: true;
        sensitive: bind template.loaded;
        activated => $on_stores_activated();

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Instance");

      Adw.ActionRow {
        title: _("Suwayomi Instance");
        subtitle: _("Switch between a local or remote server");
        activatable: true;
        action-name: "app.change_instance";

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
        }
      }

      Adw.ActionRow {
        title: _("Open in Browser");
        subtitle: _("Open the server's web interface");
        activatable: true;
        activated => $on_open_browser_activated();

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
        }
      }
    }
  }
}