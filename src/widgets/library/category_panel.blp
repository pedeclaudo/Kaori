using Gtk 4.0;
using Adw 1;

template $KaoriCategoryPanel : Adw.Bin {
  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle {
        title: _("Categories");
      };

      [start]
      Gtk.Button {
        icon-name: "document-edit-symbolic";
        tooltip-text: _("Manage Categories");
        clicked => $on_manage_clicked();
      }

      [end]
      Gtk.ToggleButton search_button {
        icon-name: "edit-find-symbolic";
        tooltip-text: _("Search Categories");
        active: bind search_bar.search-mode-enabled bidirectional;
      }
    }

    [top]
    Gtk.SearchBar search_bar {
      notify::search-mode-enabled => $on_search_mode_changed();

      child: Gtk.SearchEntry search_entry {
        hexpand: true;
        placeholder-text: _("Search categories");
        search-changed => $on_search_changed();
      };
    }

    content: Gtk.ScrolledWindow {
      hscrollbar-policy: never;
      vexpand: true;

      child: Gtk.ListView category_list {
        styles [
          "navigation-sidebar"
        ]
        single-click-activate: false;
        activate => $on_activate();
        width-request: 300;

        factory: Gtk.SignalListItemFactory {
          setup => $on_setup();
          bind => $on_bind();
          unbind => $on_unbind();
        };
      };
    };
  };
}